{
  "case": "E1",
  "spike": "S0-E",
  "cwd": "{SRC}",
  "hook": "log",
  "allow": [
    "Read(/{SRC}/**)"
  ],
  "deny": [
    "Read(~/.ssh/**)",
    "Read(~/.config/gh/**)",
    "Bash(git push:*)",
    "Bash(gh:*)",
    "Bash(claude:*)",
    "WebSearch"
  ],
  "allowWrite": [],
  "denyWrite": [],
  "denyRead": [
    "~/.ssh",
    "~/.aws",
    "~/.config/gh"
  ]
}
