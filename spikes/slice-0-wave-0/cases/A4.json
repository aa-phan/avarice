{
  "case": "A4",
  "spike": "S0-A",
  "cwd": "{SRC}",
  "hook": "allow-preamble",
  "allow": [
    "Read(/{SRC}/**)",
    "Read(/{GSD}/**)",
    "Edit(/{SRC}/.planning/codebase/**)",
    "Glob",
    "Grep",
    "Agent",
    "Bash(gsd_run:*)",
    "Bash(ls:*)",
    "Bash(cat:*)",
    "Bash(head:*)",
    "Bash(wc:*)",
    "Bash(git ls-files:*)",
    "Bash(git log:*)",
    "Bash(git rev-parse:*)"
  ],
  "deny": [
    "Read(~/.ssh/**)",
    "Read(~/.config/gh/**)",
    "Bash(git push:*)",
    "Bash(gh:*)",
    "Bash(claude:*)",
    "WebSearch"
  ],
  "allowWrite": [
    "{SRC}/.planning/codebase"
  ],
  "denyWrite": [
    "{SRC}/src",
    "{SRC}/docs",
    "{SRC}/README.md",
    "{SRC}/CLAUDE.md",
    "{SRC}/.env",
    "{SRC}/.git"
  ],
  "denyRead": [
    "~/.ssh",
    "~/.aws",
    "~/.config/gh"
  ],
  "mkdirs": [
    "{SRC}/.planning/codebase"
  ]
}
