{
  "case": "C1",
  "spike": "S0-C",
  "cwd": "{SRC}",
  "hook": "log",
  "pathMode": "gsd-first",
  "allow": [
    "Read(/{SRC}/**)",
    "Bash"
  ],
  "deny": [
    "Read(~/.ssh/**)",
    "Read(~/.config/gh/**)",
    "Bash(git push:*)",
    "Bash(gh:*)",
    "Bash(claude:*)",
    "WebSearch"
  ],
  "allowWrite": [],
  "denyWrite": [
    "{SRC}/src",
    "{SRC}/docs",
    "{SRC}/README.md",
    "{SRC}/CLAUDE.md",
    "{SRC}/.env",
    "{SRC}/.git"
  ],
  "denyRead": [
    "~/.ssh",
    "~/.aws",
    "~/.config/gh"
  ]
}
